# BACKEND ENVIRONMENT VARIABLES (.env.example)
# Copy this file to .env and fill in your actual values

# MongoDB Connection URI
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/dbname
# For Local MongoDB: mongodb://username:password@localhost:27017/dbname
MONGO_URI=mongodb+srv://<username>:<password>@clippy.ucnsu9g.mongodb.net/clippy?appName=clippy

# Server Configuration
BACKEND_PORT=3001
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# File Upload Configuration
MAX_FILE_SIZE_MB=10

# Rate Limiting (browser fingerprint-based)
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=20

# Paste Expiry Configuration (in minutes)
PASTE_DEFAULT_EXPIRY_MINUTES=60
PASTE_MAX_EXPIRY_MINUTES=1440

# Docker Compose only: credentials for the bundled MongoDB container.
# Put these in a .env file next to docker-compose.yml (it is gitignored).
# Use a password without @ : / ? # characters, since it goes into a URI.
MONGO_ROOT_USERNAME=clippy
MONGO_ROOT_PASSWORD=change-me

# Wrong-code lookup limit (per fingerprint)
LOOKUP_LIMIT_WINDOW_MS=600000
LOOKUP_LIMIT_MAX_FAILURES=30

# Proxy hops in front of the API (1 for the bundled nginx)
TRUST_PROXY=1

# Header the proxy in front of the API sets to the visitor's IP. On Render
# (behind Cloudflare) set this to cf-connecting-ip. Leave it empty for
# local dev and Docker: there a client could put any IP in that header.
CLIENT_IP_HEADER=
