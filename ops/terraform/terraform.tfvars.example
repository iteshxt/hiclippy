# Copy to terraform.tfvars (gitignored) and fill in. Never commit the copy.
#
#   cp terraform.tfvars.example terraform.tfvars
#
# Alternatively, export each one as TF_VAR_<name>, e.g.
#   export TF_VAR_vercel_api_token=...

# ── Credentials ─────────────────────────────────────────────────────
vercel_api_token    = ""   # vercel.com/account/settings/tokens, scope: temp-stuff team
render_api_key      = ""   # dashboard.render.com > Account settings > API keys
render_owner_id     = ""   # usr-... or tea-...; shown in Render's account/team settings
hostinger_api_token = ""   # hPanel > Account > API

# MongoDB Atlas: fill ONE pair. Service account (recommended):
atlas_client_id     = ""
atlas_client_secret = ""
# ...or a programmatic API key (then delete the two lines above):
# atlas_public_key  = ""
# atlas_private_key = ""

# ── IDs of what already exists ──────────────────────────────────────
render_service_id     = ""   # srv-... from the API service's URL in the Render dashboard

